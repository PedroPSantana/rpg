# Copy to .env and adjust. Never commit real credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rpg?schema=public"
# Separate database used by integration tests (created by `pnpm db:test:prepare`).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rpg_test?schema=public"

# AI Game Master provider: "offline" (deterministic, no key) or "anthropic".
GM_PROVIDER="offline"
# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
GM_TIMEOUT_MS="45000"
